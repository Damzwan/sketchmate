<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- TOP BAR: avatar + sender name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_chip_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/widget_image_avatar"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/avatar" />

        <TextView
            android:id="@+id/widget_image_user"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Friend"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- IMAGE: whole drawing, contained, fills the middle -->
    <ImageView
        android:id="@+id/widget_image_drawing"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:contentDescription="Latest Sketchmate Drawing"
        android:src="@drawable/cat"
        app:srcCompat="@drawable/cat"
        android:scaleType="fitCenter" />

    <!-- BOTTOM BAR: controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_chip_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <ImageView
            android:id="@+id/widget_button_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:src="@drawable/ic_widget_prev" />

        <ImageView
            android:id="@+id/widget_button_reset"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="18dp"
            android:padding="12dp"
            android:src="@drawable/ic_widget_reset" />

        <ImageView
            android:id="@+id/widget_button_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="18dp"
            android:padding="11dp"
            android:src="@drawable/ic_widget_next" />
    </LinearLayout>

</LinearLayout>
