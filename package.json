{
	"name": "SketchMate",
	"private": true,
	"version": "0.4.4",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"start": "ionic serve --external",
		"start_ios": "ionic capacitor run ios -l --external",
		"start_android": "ionic capacitor run android -l --external",
		"build": "vite build",
		"build_android": "vite build && npx cap sync android && npx cap copy android",
		"build_android_test": "VITE_DRAW_TESTING=si vite build && npx cap sync android && npx cap copy android",
		"preview": "vite preview",
		"test:unit": "vitest",
		"bench:check": "node scripts/benchCompare.mjs",
		"lint": "biome check .",
		"heroku:start": "node server.js",
		"prepare": "git config core.hooksPath .githooks || true",
		"lint:fix": "biome check . --write",
		"typecheck": "vue-tsc --noEmit",
		"verify": "biome check . && vue-tsc --noEmit && vitest run && vite build && node scripts/checkBudget.mjs",
		"budget": "node scripts/checkBudget.mjs",
		"mem": "node scripts/memProfile.mjs"
	},
	"dependencies": {
		"@capacitor-firebase/authentication": "^8.1.0",
