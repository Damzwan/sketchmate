		"@mdi/js": "^7.4.47",
		"@tailwindcss/vite": "^4.3.3",
		"@types/fontfaceobserver": "^2.1.3",
		"@types/node": "^20.19.37",
		"@types/point-in-polygon": "^1.1.5",
